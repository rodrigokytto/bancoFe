NODE_ENV=production
PORT=3000

# Identificação Regulatória BACEN
BACEN_ISPB=00000799
BACEN_BANK_CODE=799
BACEN_SPI_ENVIRONMENT=PRD
BACEN_DICT_URL=https://dict.spi.bcb.gov.br/api/v1

# FEBRABAN & CIP
FEBRABAN_CONVENIO_CIP=1234567
FEBRABAN_BENEFICIARY_DOCUMENT=12.345.678/0001-90

# Open Finance Brasil (FAPI 1.0)
OPEN_FINANCE_ORG_ID=org_bancofe_001
OPEN_FINANCE_KEY_ID=k_prd_2026_01

# Segredos e Tokens de Integração MCP / Gateways
ASAAS_API_KEY=your_asaas_api_key_here
EFI_CLIENT_ID=your_efi_client_id_here
EFI_CLIENT_SECRET=your_efi_client_secret_here
STRIPE_SECRET_KEY=sk_live_...
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-...
OPENPIX_APP_ID=your_openpix_app_id
CELCOIN_CLIENT_ID=your_celcoin_client_id
CELCOIN_CLIENT_SECRET=your_celcoin_client_secret

# Piloto Drex (Hyperledger Besu)
DREX_RPC_ENDPOINT=https://drex-besu.bcb.gov.br/rpc
DREX_TREASURY_WALLET=0x71C838942B491290384729103984102938471029
